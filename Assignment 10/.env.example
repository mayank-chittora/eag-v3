# ============================================================
#  Assignment 10 — V9 Gateway environment variables
#  Copy this file to .env (same directory) and fill in keys.
#
#  Location: Assignment 10/.env
#  Loaded by: gateway/main.py via python-dotenv
# ============================================================

# ── LLM providers (at least one required) ──────────────────
#
#  The gateway tries providers in LLM_ORDER (left → right).
#  Only providers whose key is set are registered — comment
#  out any you don't need.

GEMINI_API_KEY=your_gemini_api_key_here
# NVIDIA_API_KEY=your_nvidia_api_key_here
# GROQ_API_KEY=your_groq_api_key_here
# CEREBRAS_API_KEY=your_cerebras_api_key_here
# OPEN_ROUTER_API_KEY=your_openrouter_api_key_here
# GITHUB_ACCESS_TOKEN=your_github_pat_here   # used for GitHub Models

# ── Provider model overrides (optional) ────────────────────
#
#  Defaults are shown. Override only if you want a different model.

# GEMINI_MODEL=gemini-2.5-flash
# NVIDIA_MODEL=deepseek-ai/deepseek-v3.2
# GROQ_MODEL=openai/gpt-oss-120b
# CEREBRAS_MODEL=zai-glm-4.7
# OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# GITHUB_MODEL=openai/gpt-4.1-mini

# ── Ollama (local, no key needed) ──────────────────────────
#
#  Uncomment and set OLLAMA_MODEL to enable the local provider.

# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# ── Provider priority order ─────────────────────────────────
#
#  Comma-separated list. The gateway tries left-to-right and
#  skips providers whose key is not set.

LLM_ORDER=ollama,gemini,nvidia,groq,cerebras,openrouter,github

# ── Router (skill → provider pinning) ──────────────────────
#
#  Providers tried by the internal skill router. Separate from
#  LLM_ORDER — the router resolves which provider handles a
#  given skill before the main ladder is consulted.

# ROUTER_ORDER=cerebras,groq,nvidia,github

# Router model overrides (per provider, for the router only):
# ROUTER_CEREBRAS_MODEL=zai-glm-4.7
# ROUTER_GROQ_MODEL=moonshotai/kimi-k2-instruct
# ROUTER_NVIDIA_MODEL=deepseek-ai/deepseek-v3.2
# ROUTER_GITHUB_MODEL=openai/gpt-4.1-mini

# ── Embeddings ──────────────────────────────────────────────
#
#  Embedding provider for /v1/embed.  Defaults to Ollama first,
#  falls back to Gemini if EMBED_FALLBACK_PROVIDER is set.

# EMBED_FALLBACK_PROVIDER=gemini
# EMBED_FALLBACK_MODEL=gemini-embedding-001
# EMBED_OLLAMA_MODEL=nomic-embed-text
# EMBED_ORDER=ollama,gemini

# ── Gateway server ──────────────────────────────────────────

GATEWAY_V9_PORT=8109

# ── Agent code client ───────────────────────────────────────
#
#  URL the computer/browser skills use to reach the gateway.
#  Change only if you moved the gateway to a different host/port.

# LLM_GATEWAY_V9_URL=http://localhost:8109
